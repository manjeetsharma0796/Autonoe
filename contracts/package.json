{
  "name": "@autonoe/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat compile",
    "test:hardhat": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat test",
    "deploy": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy.ts",
    "deploy:testnet": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true DEPLOY_NETWORK=mantleSepolia hardhat run scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test-unit"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "hardhat": "^3.0.0"
  }
}
